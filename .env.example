# Crie um arquivo .env (copie este) e preencha com os dados do seu projeto Supabase
# Dashboard: https://supabase.com → Settings → API

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Push permanece inativo até a migration, o webhook e os serviços externos serem validados.
VITE_PUSH_ENABLED=false

# Leituras FastAPI: habilitar somente após validação em staging.
VITE_API_READS_ENABLED=false
VITE_API_URL=https://api.exemplo.com
VITE_API_DELETION_REQUESTS_ENABLED=false
VITE_API_REPORT_WRITES_ENABLED=false
VITE_API_VOTES_ENABLED=false
VITE_API_COMMUNITY_STATUS_ENABLED=false

# Variáveis somente de servidor (configurar na Vercel; nunca usar VITE_):
# PUSH_ENABLED
# PUSH_SECRET
# SUPABASE_SERVICE_ROLE_KEY
# FIREBASE_SERVICE_ACCOUNT
